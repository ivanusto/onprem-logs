# /etc/pcap/syslog.env: what reaches this host on the Day 21 ports, 514 (NAS
# and FortiGate syslog) and 9428 (journal upload). Meant for the collector
# VM when a source goes quiet (Day 22's FwSilent) and the question is
# "does anything arrive at the NIC at all". 128 bytes also keeps the first
# 60 to 70 bytes of each segment's message text, which is in VictoriaLogs
# anyway.
IFACE=auto
PEER=192.168.2.2
FILTER="tcp port 514 or tcp port 9428"
SNAPLEN=128
MODE=timed
ROTATE_SECONDS=300
KEEP_FILES=2
