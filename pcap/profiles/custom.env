# /etc/pcap/custom.env: edit before `systemctl start pcap@custom`. Every
# variable is documented at the top of pcap-run.sh. Keep SNAPLEN small
# unless the payload is the question; a full-payload capture holds whatever
# crossed the wire, including file contents and credentials in clear-text
# protocols, and the archive is WORM.
IFACE=auto
PEER=192.168.2.2
FILTER=""
SNAPLEN=256
MODE=timed
ROTATE_SECONDS=300
KEEP_FILES=1
