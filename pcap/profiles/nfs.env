# /etc/pcap/nfs.env: the NFS model library mount to the primary NAS (Day 13).
# Headers only: 256 bytes keeps Ethernet + IP + TCP + RPC + the NFSv4
# compound header, not the file data of READ/WRITE. One hour in six files
# of ten minutes, then tcpdump exits by itself.
# IFACE=auto picks the interface that routes to PEER (the 10GbE link, not
# the CX7 pair the NCCL traffic uses). nconnect=4 opens four TCP
# connections; the filter covers them all.
IFACE=auto
PEER=192.168.2.2
FILTER="host 192.168.2.2 and tcp port 2049"
SNAPLEN=256
MODE=timed
ROTATE_SECONDS=600
KEEP_FILES=6
